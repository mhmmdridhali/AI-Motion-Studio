# Dependencies & Python virtual environments
**/node_modules/
**/.venv/
.venv/
__pycache__/
*.pyc

# Upstream Lemo-Opuscar library (reproducible via setup.sh; avoids tracking 3,000+ vendor files)
lemo-opuscar/

# Rendered videos, generated audio, and binary TTS/model files (documentation & code only on GitHub)
*.mp4
*.webm
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.onnx
*.bin
archive/
sipelita-demo/
projects/**/output/

# Local-only raw third-party reference videos/frames, raw still frames, and full copy-pasted articles/PDFs
projects/**/ref/
projects/**/source/
projects/**/boards/stills/

# Secrets & local environment variables (never commit real API keys)
.env
.env.*
!.env.example

# Caches, temporary directories, test artifacts, logs, and OS files
.tmp-*
**/.cache/
**/.lines-cache/
**/.espeak-ng-data/
**/test-results/
**/.hyperframes/
*.log
.DS_Store
Thumbs.db
